generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// نموذج المستخدم — عدّله حسب احتياج مشروعك
// ============================================================
model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  passwordHash  String? // فارغ عند استخدام تسجيل الدخول عبر مزودات OAuth
  image         String?
  emailVerified Boolean       @default(false)
  role          String        @default("USER") // USER | ADMIN
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  resetTokens   PasswordResetToken[]
}

// رموز استعادة كلمة المرور (في الإنتاج: تُرسل عبر البريد الإلكتروني)
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// الاشتراكات — أنظمة: BASIC | PRO | AGENCY
// ============================================================
model Subscription {
  id               String    @id @default(cuid())
  plan             String // BASIC | PRO | AGENCY
  status           String    @default("ACTIVE") // ACTIVE | CANCELED | EXPIRED
  amount           Int // بالهللات (1 ريال = 100 هللة)
  currency         String    @default("SAR")
  interval         String    @default("month") // month | year
  currentPeriodEnd DateTime?
  userId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// المدفوعات — تدعم Moyasar وTap وأي بوابة مستقبلية
// ============================================================
model Payment {
  id                String   @id @default(cuid())
  amount            Int // بالهللات
  currency          String   @default("SAR")
  status            String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  provider          String   @default("demo") // moyasar | tap | demo
  providerPaymentId String? // معرّف العملية لدى البوابة
  description       String?
  plan              String? // BASIC | PRO | AGENCY
  userId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id])
}
